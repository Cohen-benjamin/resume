# Copy to .env. Never commit the real thing -- .gitignore already excludes it.

# Required: profile extraction, fit scoring, and the how-to-land-it briefs.
ANTHROPIC_API_KEY=

# Required for job search. Free key: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Required only to email the digest. Free tier: https://resend.com/
RESEND_API_KEY=
DIGEST_TO_EMAIL=you@example.com
DIGEST_FROM_EMAIL=JobScout <onboarding@resend.dev>

# Optional. Raises BLS rate limits; unregistered access works without it.
# https://data.bls.gov/registrationEngine/
BLS_API_KEY=
